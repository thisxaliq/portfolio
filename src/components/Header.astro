---
import { sitecfg } from "../consts";
import {langs} from "../consts";

const { lang } = Astro.props;
const icon = sitecfg.person.name.split(' ').map((n) => n[0].toUpperCase()).join('');
const navItems = lang.nav;
const language = lang.lang

---

<header>
	<div class="container header">
		<a class="menuIcon" href="/">{icon}</a>
		<nav class="mainNav" aria-label="Main navigation">
			<ul>
				{Object.entries(navItems).map(([key, item]) => (
					<li><a href={`#${key}`}>{item}</a></li>
				))}
			</ul>
		</nav>
		<nav class="langNav" aria-label="Language navigation">
			<ul>
				{langs.map((l) => (<li class={language === l ? "isselect" : ""} ><a  href={`/${l}/`}>{l.toUpperCase()}</a></li>))}
			</ul>
		</nav>
		<div class="button">
			<button onclick="changeThem()">MODE</button>
		</div>
	</div>
</header>